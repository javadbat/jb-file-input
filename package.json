      "types": "./react/dist/JBFileInput.d.ts",
      "default": "./react/index.js"
    },
    "./*": "./*"
  },
  "main": "index.js",
  "customElements": "web-component/custom-elements.json",
  "repository": {
		"type": "git",
		"url": "https://github.com/javadbat/jb-file-input.git"
  },
  "dependencies":{
    "jb-validation":"^1.0.0",
    "jb-button":"^4.2.0",
    "jb-loading":"^1.8.1",
    "jb-core":"^0.36.0"
  },
  "devDependencies": {
    "jb-form":"0.13.0"
  }
}
